# Copia este archivo como ".env", reemplaza los valores con los de tu proyecto de Supabase,
# y expórtalos a tu shell antes de correr la app:
#   set -a && source .env && set +a
# Nunca subas el ".env" real al repositorio. Envuelve TODOS los valores en comillas simples
# (no solo el password): la URL trae "&" y "?", que bash interpreta como caracteres
# especiales si no están entre comillas.

# Settings > Database > Connection string. Spring necesita el prefijo "jdbc:" y las
# credenciales van aparte en DB_USERNAME/DB_PASSWORD (no dentro de la URL).
# "prepareThreshold=0" es obligatorio con el pooler de Supabase (modo transacción):
# sin esto, el driver JDBC choca con "prepared statement already exists".
DB_URL='jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0'
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD='<tu-password-de-supabase>'

SERVER_PORT=8080

# Secreto para firmar JWT (mínimo 32 caracteres). Genera uno con: openssl rand -base64 32
JWT_SECRET='<genera-un-secreto-largo-y-aleatorio>'
JWT_EXPIRATION_MINUTES=1440
